rules_version = '2';
// Reglas de seguridad de Neiva Belleza (Firestore).
// Se pegan en Firebase → Firestore Database → Reglas → Publicar.
//
// Idea general:
//  · El catálogo (servicios, equipo, productos, festivos) lo ve todo el mundo y solo lo edita el salón.
//  · Las clientas no tienen cuenta: su cita se abre con un enlace secreto (el id del documento es ese secreto).
//  · Dos citas de la misma profesional no se pueden cruzar: cada cita aparta "casillas" de 15 minutos
//    (colección casillas) que solo se pueden crear si están libres.
//  · El panel (dueña, recepción, estilista) entra con cuenta y lo que ve depende de su rol.
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== QUIÉN ES QUIÉN =====
    function conCuenta() { return request.auth != null; }
    function rutaPerfil() { return /databases/$(database)/documents/perfiles/$(request.auth.uid); }
    function esPersonal() { return conCuenta() && exists(rutaPerfil()); }
    function rol() { return get(rutaPerfil()).data.rol; }
    function esAdmin() { return esPersonal() && rol() in ['duena', 'recepcion']; }
    function esDuena() { return esPersonal() && rol() == 'duena'; }
    function miProfesional() { return get(rutaPerfil()).data.profesional_id; }

    // ===== AYUDAS =====
    function nuevo() { return request.resource.data; }
    function cambia(campos) { return nuevo().diff(resource.data).affectedKeys().hasOnly(campos); }
    function texto(v, max) { return v is string && v.size() <= max; }
    function textoOpcional(v, max) { return v == null || texto(v, max); }
    function entero(v, min, max) { return v is int && v >= min && v <= max; }
    function lista(v, max) { return v is list && v.size() <= max; }
    function reserva(id) { return /databases/$(database)/documents/reservas/$(id); }

    // ===== CATÁLOGO =====
    match /categorias/{id} { allow read: if true; allow write: if esAdmin(); }
    match /servicios/{id} { allow read: if true; allow write: if esAdmin(); }
    match /disenos/{id} { allow read: if true; allow write: if esAdmin(); }
    match /profesionales/{id} { allow read: if true; allow write: if esAdmin(); }
    match /productos/{id} { allow read: if true; allow write: if esAdmin(); }
    match /festivos/{fecha} { allow read: if true; allow write: if esAdmin(); }
    match /bloqueos/{id} {
      allow read: if true; // solo horas: la página los usa para no ofrecer horarios bloqueados
      allow create: if esAdmin() || (esPersonal() && nuevo().profesional_id == miProfesional());
      allow delete: if esAdmin() || (esPersonal() && resource.data.profesional_id == miProfesional());
    }
    match /config/{clave} {
      allow read: if resource.data.publica == true || esPersonal();
      allow write: if esAdmin();
    }

    // ===== CUENTAS DEL EQUIPO =====
    match /perfiles/{uid} {
      allow read: if esPersonal() || (conCuenta() && request.auth.uid == uid);
      // La dueña (su correo, ya confirmado) crea su propio perfil la primera vez que entra
      allow create: if esDuena()
        || (conCuenta() && request.auth.uid == uid
            && request.auth.token.email == 'anfebolivar@gmail.com' && request.auth.token.email_verified == true
            && nuevo().rol == 'duena');
      allow update, delete: if esDuena();
    }
    match /solicitudes_acceso/{uid} {
      allow read: if esDuena() || (conCuenta() && request.auth.uid == uid);
      allow create: if conCuenta() && request.auth.uid == uid && nuevo().aprobada == false
        && texto(nuevo().email, 120) && texto(nuevo().nombre, 80);
      allow update, delete: if esDuena();
    }

    // ===== CLIENTAS (id = celular) =====
    match /clientas/{tel} {
      allow read, update: if esPersonal();
      allow delete: if esAdmin();
      // Al reservar por primera vez se crea su ficha, sin sellos ni puntos regalados
      allow create: if esPersonal() || (
        nuevo().keys().hasOnly(['id', 'nombre', 'telefono', 'email', 'cumpleanos', 'acepta_promos', 'codigo_referido',
                                'referida_por', 'sellos', 'puntos', 'etiquetas', 'alergias', 'notas', 'creada'])
        && nuevo().telefono == tel && nuevo().id == tel && texto(nuevo().nombre, 80)
        && nuevo().sellos == 0 && nuevo().puntos == 0 && nuevo().etiquetas.size() == 0
        && nuevo().alergias == '' && nuevo().notas == '' && textoOpcional(nuevo().email, 120));
    }

    // ===== CITAS (id = enlace secreto de la clienta) =====
    match /reservas/{token} {
      allow get: if true;
      allow list: if esAdmin() || (esPersonal() && resource.data.profesional_id == miProfesional());

      allow create: if esPersonal() || (
        nuevo().token == token && nuevo().id == token
        && nuevo().estado == 'pendiente' && nuevo().descuento == 0 && nuevo().cupon == null
        && nuevo().resenada == false && nuevo().recordatorio_enviado == false
        && nuevo().origen in ['web', 'instagram', 'google', 'whatsapp', 'referido']
        && nuevo().inicio is timestamp && nuevo().fin is timestamp
        && nuevo().inicio > request.time + duration.value(25, 'm')
        && nuevo().inicio < request.time + duration.value(125, 'd')
        && nuevo().fin > nuevo().inicio && nuevo().fin <= nuevo().inicio + duration.value(6, 'h')
        && entero(nuevo().total, 0, 10000000) && nuevo().total == nuevo().subtotal
        && lista(nuevo().servicios, 6) && lista(nuevo().productos, 10) && texto(nuevo().nota, 500)
        && existsAfter(/databases/$(database)/documents/ocupados/$(token)));

      allow update: if esAdmin()
        || (esPersonal() && resource.data.profesional_id == miProfesional() && nuevo().profesional_id == miProfesional())
        // La clienta confirma que viene
        || (cambia(['estado', 'actualizada']) && resource.data.estado in ['pendiente', 'confirmada'] && nuevo().estado == 'confirmada')
        // La clienta cancela (hasta 24 horas antes)
        || (cambia(['estado', 'actualizada']) && resource.data.estado in ['pendiente', 'confirmada'] && nuevo().estado == 'cancelada'
            && resource.data.inicio > request.time + duration.value(24, 'h'))
        // La clienta cambia la hora (hasta 24 horas antes, misma duración)
        || (cambia(['inicio', 'fin', 'estado', 'actualizada', 'recordatorio_enviado'])
            && resource.data.estado in ['pendiente', 'confirmada'] && nuevo().estado == 'pendiente'
            && resource.data.inicio > request.time + duration.value(24, 'h')
            && nuevo().inicio > request.time + duration.value(25, 'm')
            && nuevo().fin - nuevo().inicio == resource.data.fin - resource.data.inicio)
        // Cupón: una sola vez y con el descuento exacto que da el cupón
        || (cambia(['cupon', 'descuento', 'total', 'actualizada']) && resource.data.cupon == null
            && resource.data.estado in ['pendiente', 'confirmada'] && cuponValido(nuevo().cupon, resource.data.subtotal)
            && nuevo().descuento == descuentoDe(nuevo().cupon, resource.data.subtotal)
            && nuevo().total == resource.data.subtotal - nuevo().descuento)
        // Marca de "ya dejó su opinión" después de la cita
        || (cambia(['resenada']) && resource.data.estado == 'terminada' && resource.data.resenada == false && nuevo().resenada == true);
    }

    // Horas ocupadas sin datos personales (la página arma la agenda con esto)
    match /ocupados/{token} {
      allow read: if true;
      allow create, update: if esPersonal() || (
        existsAfter(reserva(token)) && nuevo().keys().hasOnly(['profesional_id', 'inicio', 'fin'])
        && nuevo().inicio == getAfter(reserva(token)).data.inicio && nuevo().fin == getAfter(reserva(token)).data.fin
        && nuevo().profesional_id == getAfter(reserva(token)).data.profesional_id);
      allow delete: if esPersonal() || getAfter(reserva(token)).data.estado in ['cancelada', 'no_asistio'];
    }

    // Casillas de 15 minutos por profesional: si ya existe, ese horario está tomado
    match /casillas/{id} {
      allow read: if esPersonal();
      allow create: if esPersonal() || (
        nuevo().keys().hasOnly(['reserva', 't']) && existsAfter(reserva(nuevo().reserva))
        && getAfter(reserva(nuevo().reserva)).data.inicio <= nuevo().t && nuevo().t < getAfter(reserva(nuevo().reserva)).data.fin);
      allow delete: if esPersonal()
        || getAfter(reserva(resource.data.reserva)).data.estado in ['cancelada', 'no_asistio']
        || !(getAfter(reserva(resource.data.reserva)).data.inicio <= resource.data.t
             && resource.data.t < getAfter(reserva(resource.data.reserva)).data.fin);
    }

    match /lista_espera/{id} {
      allow read, update, delete: if esAdmin();
      allow create: if esAdmin() || (texto(nuevo().nombre, 80) && texto(nuevo().telefono, 15) && nuevo().avisada == false);
    }

    match /fichas/{id} { allow read, create: if esPersonal(); }

    // ===== CUPONES =====
    function cupon(c) { return get(/databases/$(database)/documents/cupones/$(c)).data; }
    function cuponValido(c, subtotal) {
      return c is string && exists(/databases/$(database)/documents/cupones/$(c)) && cupon(c).activo == true
        && subtotal >= cupon(c).minimo
        && (cupon(c).usos_max == null || cupon(c).usos < cupon(c).usos_max);
    }
    function descuentoDe(c, subtotal) {
      return cupon(c).tipo == 'porcentaje' ? math.round(subtotal * cupon(c).valor / 100) : math.min(cupon(c).valor, subtotal);
    }
    match /cupones/{codigo} {
      allow get: if true;
      allow list, create, delete: if esAdmin();
      allow update: if esAdmin() || (cambia(['usos']) && nuevo().usos == resource.data.usos + 1
        && resource.data.activo == true && (resource.data.usos_max == null || resource.data.usos < resource.data.usos_max));
    }

    // ===== TIENDA Y REGALOS =====
    match /pedidos/{codigo} {
      allow read, update, delete: if esAdmin();
      allow create: if esAdmin() || (
        nuevo().codigo == codigo && nuevo().estado == 'nuevo' && nuevo().pagado == false
        && nuevo().stock_descontado == false && texto(nuevo().nombre, 80) && texto(nuevo().telefono, 15)
        && lista(nuevo().items, 20) && nuevo().items.size() > 0 && entero(nuevo().total, 0, 10000000)
        && nuevo().entrega in ['recoger', 'domicilio'] && texto(nuevo().direccion, 200) && texto(nuevo().notas, 300));
    }
    match /tarjetas_regalo/{codigo} {
      allow get: if true; // quien tiene el código consulta su saldo
      allow list, update, delete: if esAdmin();
      allow create: if esAdmin() || (
        nuevo().codigo == codigo && nuevo().estado == 'pendiente_pago' && entero(nuevo().valor_inicial, 20000, 2000000)
        && nuevo().saldo == nuevo().valor_inicial && texto(nuevo().de, 80) && texto(nuevo().para, 80)
        && texto(nuevo().telefono, 15) && texto(nuevo().mensaje, 200));
    }

    // ===== OPINIONES Y GALERÍA =====
    match /resenas/{id} {
      allow read: if resource.data.aprobada == true || esPersonal();
      allow update, delete: if esAdmin();
      // Llegan sin publicar: la dueña o recepción las revisa antes de que salgan en la página
      allow create: if nuevo().aprobada == false && entero(nuevo().estrellas, 1, 5) && texto(nuevo().texto, 600)
        && texto(nuevo().nombre, 40) && texto(nuevo().servicio, 120);
    }
    match /galeria/{id} {
      allow read: if resource.data.visible == true || esPersonal();
      allow create: if esPersonal();
      allow update, delete: if esAdmin() || (esPersonal() && resource.data.profesional_id == miProfesional());
    }

    // ===== CAJA, GASTOS E INVENTARIO =====
    match /caja_turnos/{id} { allow read, write: if esAdmin(); }
    match /ventas/{id} {
      allow read: if esAdmin() || (esPersonal() && resource.data.profesional_id == miProfesional());
      allow write: if esAdmin();
    }
    match /gastos/{id} { allow read, write: if esAdmin(); }
    match /proveedores/{id} { allow read, write: if esAdmin(); }
    match /inventario_movimientos/{id} { allow read, write: if esAdmin(); }

    // ===== HISTORIAL DE CAMBIOS =====
    match /auditoria/{id} {
      allow read: if esDuena();
      allow create: if texto(nuevo().tabla, 40) && texto(nuevo().accion, 40) && nuevo().detalle is map;
    }
  }
}
